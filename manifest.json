{
  "manifest_version": 3,
  "name": "Universal llama.cpp Monitor",
  "version": "1.0.0",
  "key": "",
  "description": "Real-time GPU, CPU, RAM and token telemetry for llama.cpp, Unsloth & local inference engines.",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging",
    "system.cpu",
    "system.memory",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "Open LLM Monitor"
  },
  "side_panel": {
    "default_path": "sidepanel/monitor.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.js",
        "dashboard.css",
        "tokens.css",
        "sidepanel/monitor.html",
        "sidepanel/monitor.js",
        "sidepanel/monitor.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
